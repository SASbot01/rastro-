# =====================================================================
# Rastro — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se sube al repo (ya está en .gitignore).
# =====================================================================

# --- Aplicación ---------------------------------------------------
# URL pública. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto para firmar/hashear tokens de verificación e IPs.
# Genera uno con:  openssl rand -hex 32
APP_SECRET=

# --- Supabase (Postgres + auth) -----------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (correo transaccional) --------------------------------
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Rastro <hola@turodominio.com>"
RESEND_FROM="Rastro <onboarding@resend.dev>"

# --- APIs de datos (se usan a partir del Día 2) -------------------
HIBP_API_KEY=
BRAVE_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# --- Stripe (Semana 2 — todavía sin usar) -------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Modelo que redacta el informe (por defecto claude-sonnet-5; claude-opus-5 si prefieres calidad sobre coste)
ANTHROPIC_MODEL=claude-sonnet-5

# Cron de borrado a 30 dias (Vercel lo envia como Authorization: Bearer). Genera uno con: openssl rand -hex 32
CRON_SECRET=

# Solo desarrollo: pon 1 para saltarte los limites de 3/correo y 20/IP al dia
# RATE_LIMIT_DISABLED=1
