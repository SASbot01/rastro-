# =====================================================================
# Rastro — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se sube al repo (ya está en .gitignore).
# =====================================================================

# --- Aplicación ---------------------------------------------------
# URL pública. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto para firmar/hashear tokens de verificación e IPs.
# Genera uno con:  openssl rand -hex 32
APP_SECRET=

# --- Supabase (Postgres + auth) -----------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (correo transaccional) --------------------------------
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Rastro <hola@turodominio.com>"
RESEND_FROM="Rastro <onboarding@resend.dev>"

# --- APIs de datos (se usan a partir del Día 2) -------------------
HIBP_API_KEY=
BRAVE_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# --- Stripe (Semana 2 — todavía sin usar) -------------------------
# Modelo que redacta el informe (por defecto claude-sonnet-5; claude-opus-5 si prefieres calidad sobre coste)
ANTHROPIC_MODEL=claude-sonnet-5

# Cron de borrado a 30 dias (Vercel lo envia como Authorization: Bearer). Genera uno con: openssl rand -hex 32
CRON_SECRET=

# Solo desarrollo: pon 1 para saltarte los limites de 3/correo y 20/IP al dia
# RATE_LIMIT_DISABLED=1

# --- Textos legales (aparecen en /privacidad y /aviso-legal) ---
# Responsable del tratamiento con nombre real (persona o empresa) y contacto para ejercer derechos.
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_SITE_DOMAIN=

# --- Analitica (opcional, Dia 7). Plausible: pon tu dominio y se carga el script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Cloudflare Web Analytics (Analytics → Web Analytics → Añadir sitio → token del snippet)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# --- Stripe (plan Pro, semana 2) ---
STRIPE_LINK_MONTHLY=
STRIPE_LINK_YEARLY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de precio de Rastro Pro (mensual,anual). La cuenta de Stripe se comparte con otros productos: solo estos activan Pro.
STRIPE_PRICE_IDS=

# --- Google (escaner de buzon, Pro beta) ---
# OAuth client "Aplicacion web" con redireccion <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo donde llegan los mensajes de soporte (si falta, NEXT_PUBLIC_LEGAL_EMAIL)
SUPPORT_EMAIL=
# Remitente de las cartas RGPD enviadas por Rastro (por defecto cartas@<dominio de RESEND_FROM>)
LETTERS_FROM=

# Otros asistentes de IA para "que dice la IA de ti" (opcionales; sin clave se omiten)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Plan familiar (Payment Links y precios de Stripe; sin ellos no se muestra)
STRIPE_LINK_FAMILY_MONTHLY=
STRIPE_LINK_FAMILY_YEARLY=
STRIPE_PRICE_IDS_FAMILY=
NEXT_PUBLIC_FAMILY_SEATS=3
# Precios mostrados (deben coincidir con Stripe)
NEXT_PUBLIC_PRICE_MONTHLY=19 €
NEXT_PUBLIC_PRICE_YEARLY=99 €
NEXT_PUBLIC_PRICE_FAMILY_MONTHLY=29 €
NEXT_PUBLIC_PRICE_FAMILY_YEARLY=149 €

# Rastro Equipos (v5): Payment Links, precios y plazas
STRIPE_LINK_TEAM_SMALL=
STRIPE_LINK_TEAM_LARGE=
STRIPE_PRICE_IDS_TEAM=
STRIPE_PRICE_IDS_TEAM_LARGE=
NEXT_PUBLIC_TEAM_SEATS=10
NEXT_PUBLIC_TEAM_SEATS_LARGE=25
NEXT_PUBLIC_PRICE_TEAM_SMALL=149 €
NEXT_PUBLIC_PRICE_TEAM_LARGE=299 €

# --- Extension Rastro Guardian (Chrome Web Store / Edge Add-ons) ---
# URL publica de la ficha en la tienda. Con ella, /extension muestra "Añadir a Chrome" (un clic, permisos en el navegador).
# Sin ella, se muestra la instalacion manual con el zip.
NEXT_PUBLIC_CHROME_STORE_URL=
NEXT_PUBLIC_EDGE_STORE_URL=

# --- Metricas internas (/admin/metricas) ---
# Correos con acceso, separados por comas. Sin esto la pagina da 404 a todo el mundo.
ADMIN_EMAILS=
# PRODUCT_EVENTS_DISABLED=1 apaga el registro de eventos del embudo.

# --- Bot de Telegram del Guardian (opcional) ---
# Token de @BotFather. El secreto del webhook lo genera `node scripts/telegram-setup.mjs` en el servidor.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
